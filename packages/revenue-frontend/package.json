{
  "name": "revenue-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "NODE_OPTIONS='--localstorage-file=/tmp/rr-localstorage.json' react-router dev",
    "start": "react-router-serve ./build/server/index.js",
